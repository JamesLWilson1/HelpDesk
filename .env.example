# Flask application
SECRET_KEY=replace-with-a-long-random-secret
APP_ENV=development
FLASK_DEBUG=0

# Session cookies
# In production, secure cookies default to true when APP_ENV=production or FLASK_ENV=production.
# Set this only when you need an explicit override.
# SESSION_COOKIE_SECURE=true

# Email delivery for notifications and password reset links
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_DEFAULT_SENDER=helpdesk@example.com

# Optional AI ticket summaries
OPENAI_API_KEY=
